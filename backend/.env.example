# Environment Configuration

# Server
PORT=3001
HOST=127.0.0.1

# Shopify Configuration
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_admin_api_access_token
# Custom app with read_products, read_inventory scopes. GraphQL-ready.
SHOPIFY_API_VERSION=2025-10

# Credential vault (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=your_64_char_hex_key

# Note: channel credentials (eBay/Etsy/AbeBooks) are stored encrypted in the
# database via the Settings UI, not in this file.
